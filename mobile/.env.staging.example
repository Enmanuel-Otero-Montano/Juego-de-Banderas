# Copiar como .env.staging y reemplazar la URL antes de compilar.
# Este APK usa el applicationId com.enmanuelotero.atlasflags.staging y puede
# convivir con la aplicación instalada desde Play.
VITE_API_URL=https://staging-api.replace-me.example
VITE_RACE_MODE_ENABLED=true

# Vacíos: el APK staging usa las unidades de prueba incluidas en la app y no
# inicia RevenueCat. Nunca usar tráfico de prueba sobre unidades reales.
VITE_ADMOB_REWARDED_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_REVENUECAT_ANDROID_KEY=
VITE_REVENUECAT_ENTITLEMENT=premium

ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=1.0.0
