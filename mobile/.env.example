# URL HTTPS pública del backend para compilaciones Android de producción.
# En desarrollo web, si se omite, se usa http://127.0.0.1:8000.
VITE_API_URL=https://atlas-flags-api.onrender.com

# IDs públicos de las unidades creadas en AdMob.
VITE_ADMOB_APP_ID=ca-app-pub-0000000000000000~0000000000
VITE_ADMOB_REWARDED_ID=ca-app-pub-0000000000000000/0000000000
VITE_ADMOB_INTERSTITIAL_ID=ca-app-pub-0000000000000000/0000000000

# Clave pública Android, entitlement y oferta configurados en RevenueCat.
VITE_REVENUECAT_ANDROID_KEY=goog_replace_me
VITE_REVENUECAT_ENTITLEMENT=premium

# Metadatos que valida el proceso de release.
ANDROID_VERSION_CODE=1
ANDROID_VERSION_NAME=1.0.0
PLAY_PRIVACY_POLICY_URL=https://enmanuel-otero-montano.github.io/Juego-de-Banderas/privacy.html
PLAY_ACCOUNT_DELETION_URL=https://enmanuel-otero-montano.github.io/Juego-de-Banderas/delete-account.html
